# Local backend configuration. Copy to .env and change only values you understand.
APP_ENV=development
DATABASE_URL=sqlite:///./global_signals.db
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional live-news provider. Keep the real key only in the backend .env file.
NEWS_API_KEY=
NEWSAPI_PRODUCTION_AUTHORIZED=false

# Virtual account settings (INR; never connected to a broker).
SESSION_HOURS=12
SIM_STARTING_CASH=100000.00
SIM_FEE_BPS=10
SIM_SLIPPAGE_BPS=5
SIM_FOREX_FEE_BPS=10
SIM_FOREX_SLIPPAGE_BPS=5
SIM_MAX_ORDER_VALUE=25000
SIM_MAX_EXPOSURE_PERCENT=90

# Emergency global stop for every simulated order path; true blocks manual and worker orders.
SIMULATOR_KILL_SWITCH=false

# The separate development worker requires this opt-in and an enabled per-user strategy.
# Production strategy execution is intentionally disabled until market data is authorized.
STRATEGY_EXECUTION_ENABLED=false

# Read-only market-data credentials (keep on the backend only; never use VITE_* variables).
UPSTOX_ANALYTICS_TOKEN=
UPSTOX_DATA_DISPLAY_AUTHORIZED=false
TWELVEDATA_API_KEY=
TWELVEDATA_DISPLAY_LICENSE_AUTHORIZED=false
TWELVEDATA_API_CREDITS_PER_MINUTE=8

# Production paper orders remain disabled until the operator deliberately enables them.
PAPER_TRADING_ENABLED=false
